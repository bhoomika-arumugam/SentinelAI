# ==========================================
# SentinelAI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME=SentinelAI
APP_VERSION=1.0.0
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default: Local SQLite (runs anywhere with zero setup)
# For Postgres Docker: postgresql://sentinel_user:sentinel_pass@localhost:5432/sentinel_db
DATABASE_URL=sqlite:///./sentinelai.db

# Redis Event Layer / Caching (Optional - graceful degradation if unavailable)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=sentinelai_super_secret_production_key_change_in_prod_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo Admin Credentials (Initialized on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SentinelAdmin2026!
ADMIN_EMAIL=admin@sentinelai.local

ANALYST_USERNAME=analyst
ANALYST_PASSWORD=SentinelAnalyst2026!
ANALYST_EMAIL=analyst@sentinelai.local

# Hybrid Risk Engine Scoring Weights (Sum should equal 1.0)
WEIGHT_RULES=0.35
WEIGHT_ANOMALY=0.30
WEIGHT_BEHAVIOR=0.25
WEIGHT_INTELLIGENCE=0.10

# External Threat Intelligence APIs (Optional - graceful fallback if empty)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Notification Channels (Optional - graceful fallback if empty)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@sentinelai.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
ALERT_RECIPIENT_PHONE=
